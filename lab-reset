#!/usr/bin/env python3
"""lab-reset - tear a finished lab back down to a clean slate.

The inverse of ./lab-start: remove the lab's terraform state and
tfvars, unset gcloud's project/region/zone config, and revoke the
lab credentials (ADC, then the account gcloud is using - lab-start
logged in with the student credentials, so that's the one to go).

Run it from inside a lab dir, or name the lab from the repo root:

  ./lab-reset                            # current dir is the lab
  ./lab-reset landing-zone-challenge
  ./lab-reset --dry-run                  # show, don't touch

Why this exists: the old bash lab-reset.sh hung forever on
`gcloud auth application-default revoke`. It sent the command's
stdout/stderr to /dev/null, so gcloud's Y/n prompt went to the
void - while gcloud kept reading stdin, the terminal, waiting for
an answer no one could see. Two fixes here: --quiet tells gcloud
never to ask, and every subprocess gets a closed stdin so ANY
command that tries to prompt gets EOF instead of a human.
"""

import argparse
import atexit
import importlib.machinery
import importlib.util
import logging
import logging.handlers
import shutil
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent

# --- borrow lab-start's terminal toolkit -----------------------------------
# lab-start is a sibling script without a .py extension, so a plain
# `import lab-start` can't find it - SourceFileLoader loads any file
# as a module by hand. Importing is side-effect free: everything it
# does hides behind main() and its __main__ guard.
_loader = importlib.machinery.SourceFileLoader(
    "lab_start", str(REPO_ROOT / "lab-start"))
_spec = importlib.util.spec_from_loader("lab_start", _loader)
lab_start = importlib.util.module_from_spec(_spec)
_loader.exec_module(lab_start)

Spinner = lab_start.Spinner
banner = lab_start.banner
RED, GRN, YLW, BLU, CYN, RST = (
    lab_start.RED, lab_start.GRN, lab_start.YLW,
    lab_start.BLU, lab_start.CYN, lab_start.RST,
)
SHOW_CURSOR = lab_start.SHOW_CURSOR

CACHE_DIR = Path.home() / ".cache" / "lab-start"
LOG = logging.getLogger("lab-reset")


def _ensure_log() -> None:
    """Attach the debug log next to lab-start's, once per process.

    Same forensic deal as lab-start's log: the console keeps its
    curated output, the file records every command and its outcome.
    """
    if LOG.handlers:
        return
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    handler = logging.handlers.RotatingFileHandler(
        CACHE_DIR / "lab-reset.log", maxBytes=200_000, backupCount=1
    )
    handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
    LOG.addHandler(handler)
    LOG.setLevel(logging.DEBUG)


# --- subprocess plumbing ----------------------------------------------------
def run_quiet(*cmd: str) -> tuple[int, str]:
    """Run a command with output captured and STDIN CLOSED.

    Returns (returncode, output) instead of raising: every step of a
    reset is best-effort - the script reports and keeps going.

    stdin=DEVNULL is the hang fix: a subprocess that asks a question
    gets instant EOF instead of a terminal to wait on. (capture_output
    alone doesn't do this - that's exactly the bug the bash version
    shipped: the prompt was hidden, but the wait stayed.)
    """
    result = subprocess.run(cmd, stdin=subprocess.DEVNULL,
                           capture_output=True, text=True)
    output = (result.stdout or result.stderr).strip()
    LOG.debug("ran %s -> rc=%d %s", " ".join(cmd), result.returncode,
              output[-300:] if output else "(no output)")
    return result.returncode, output


def active_account() -> str | None:
    """The account gcloud is currently using.

    `gcloud auth list`'s status column renders empty in --format=value
    (the ACTIVE * is display-only), so the config property is the
    source of truth - `gcloud auth login` sets it, and lab-start signs
    in with the lab's student credentials.
    """
    rc, out = run_quiet("gcloud", "config", "get-value", "account")
    return out.strip() or None if rc == 0 else None


# --- local file cleanup -------------------------------------------------------
def delete_matching(lab_dir: Path, pattern: str, label: str,
                    dry_run: bool = False) -> int:
    """Delete lab_dir's files matching pattern; return how many.

    The same-line counter from the bash version: \r rewrites one line
    in place with a fixed-width [i/n] so the line never grows, and
    \x1b[K wipes the last frame's tail before the final newline.
    """
    files = sorted(f for f in lab_dir.rglob(pattern) if f.is_file())
    if not files:
        print(f"{GRN}No {label} files found{RST}")
        return 0
    if dry_run:
        for f in files:
            print(f"  {RED}would remove{RST} {f.relative_to(lab_dir)}")
        return len(files)

    tty = sys.stdout.isatty()
    total = len(files)
    for i, f in enumerate(files, 1):
        if tty:
            print(f"\r{RED}Removing {label} [{i:2d}/{total}] "
                  f"{f.relative_to(lab_dir)}{RST}", end="", flush=True)
        f.unlink()
    if tty:
        print(f"\r{GRN}Removed {total} {label} file(s){RST}\x1b[K")
    else:
        print(f"{GRN}Removed {total} {label} file(s){RST}")
    LOG.debug("deleted %d %s file(s) in %s", total, label, lab_dir)
    return total


# --- main -------------------------------------------------------------------
def main() -> int:
    parser = argparse.ArgumentParser(
        prog="lab-reset",
        description=(
            "Tear a finished lab back down: delete tfstate and tfvars, "
            "unset gcloud config, revoke the lab credentials."
        ),
        epilog=(
            "examples:\n"
            "  ./lab-reset                            # current dir is the lab\n"
            "  ./lab-reset landing-zone-challenge     # from the repo root\n"
            "  ./lab-reset --dry-run                  # show, don't touch\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("directory", nargs="?",
                        help="lab directory (default: current directory)")
    parser.add_argument("-n", "--dry-run", action="store_true",
                        help="show what would happen without doing it")
    args = parser.parse_args()

    banner("LAB RESET")
    _ensure_log()
    LOG.debug("invoked with %s", vars(args))

    lab_dir = Path(args.directory).resolve() if args.directory else Path.cwd()
    if not lab_dir.is_dir():
        sys.exit(f"{RED}{lab_dir} is not a directory{RST}")
    LOG.debug("resetting %s (dry_run=%s)", lab_dir, args.dry_run)
    print(f"{CYN}lab{RST} {lab_dir}\n")

    # --- local state first: tfstate and tfvars ----------------------------
    n_state = delete_matching(lab_dir, "*.tfstate*", "tfstate", args.dry_run)
    n_tfvars = delete_matching(lab_dir, "*.tfvars*", "tfvars", args.dry_run)

    # --- then gcloud: config, ADC, active account -------------------------
    results = {"config": "skipped", "adc": "skipped", "account": "skipped"}
    if shutil.which("gcloud") is None:
        print(f"{YLW}gcloud not found on PATH - skipping gcloud steps{RST}")
    elif args.dry_run:
        account = active_account()
        print(f"  {CYN}would run{RST} gcloud config unset project/region/zone")
        print(f"  {CYN}would run{RST} gcloud auth application-default revoke --quiet")
        print(f"  {CYN}would run{RST} gcloud auth revoke <active account>"
              + (f" ({account})" if account else " (none active)"))
        results["config"] = results["adc"] = results["account"] = "would run"
    else:
        with Spinner(f"{CYN}unsetting gcloud config{RST}"):
            for prop in ("project", "compute/region", "compute/zone"):
                rc, out = run_quiet("gcloud", "config", "unset", prop)
                # rc=1 "not set" is a clean second reset, not a failure
                if rc != 0:
                    LOG.debug("config unset %s -> rc=%d %s", prop, rc, out)
        results["config"] = "unset"

        # --quiet: gcloud answers its own Y/n prompt with the default
        with Spinner(f"{CYN}revoking application-default credentials{RST}"):
            rc, out = run_quiet("gcloud", "auth", "application-default",
                                "revoke", "--quiet")
        if rc == 0:
            results["adc"] = "revoked"
        else:  # e.g. "There was no ADC to revoke" - already clean
            results["adc"] = out.splitlines()[-1] if out else "failed"
            print(f"{YLW}  adc: {results['adc']}{RST}")

        # the account lab-start signed in with; printed up front so
        # there is never any mystery about WHO is being revoked
        account = active_account()
        if account:
            with Spinner(f"{CYN}revoking {account}{RST}"):
                rc, out = run_quiet("gcloud", "auth", "revoke",
                                    account, "--quiet")
            results["account"] = f"revoked {account}" if rc == 0 else "failed"
        else:
            print(f"{GRN}no active account to revoke{RST}")
            results["account"] = "none active"

    # --- summary -----------------------------------------------------------
    verb = "to remove" if args.dry_run else "removed"
    banner("DRY RUN - NOTHING CHANGED" if args.dry_run else "LAB RESET COMPLETE")
    print(f"  {CYN}tfstate{RST}   {n_state} {verb}")
    print(f"  {CYN}tfvars{RST}    {n_tfvars} {verb}")
    print(f"  {CYN}config{RST}    {results['config']}")
    print(f"  {CYN}adc{RST}       {results['adc']}")
    print(f"  {CYN}account{RST}   {results['account']}")
    print(f"  {CYN}log{RST}       {CACHE_DIR / 'lab-reset.log'}")
    LOG.debug("reset complete: %s", results)
    return 0


if __name__ == "__main__":
    # if the script dies mid-spinner, the cursor stays hidden without this
    atexit.register(lambda: print(SHOW_CURSOR, end=""))
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # 130 = 128 + SIGINT, the Unix convention for "killed by Ctrl+C"
        print(f"\n{YLW}cancelled{RST}")
        sys.exit(130)